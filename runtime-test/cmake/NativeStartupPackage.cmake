# Cold installed-candidate admission, shared by preflight and the real build.
# Inspect CMake's selected package/target, never infer Core runtime capabilities.
unset(CoAkkaV2_DIR CACHE)
find_package(CoAkkaV2 CONFIG REQUIRED
  PATHS "${COAKKA_NATIVE_EVIDENCE_RUNTIME_PREFIX}" NO_DEFAULT_PATH)
file(REAL_PATH "${COAKKA_NATIVE_EVIDENCE_RUNTIME_PREFIX}" _startup_prefix)
file(REAL_PATH "${CoAkkaV2_CONFIG}" _startup_config)
cmake_path(IS_PREFIX _startup_prefix "${_startup_config}" NORMALIZE _startup_inside)
if(NOT _startup_inside OR NOT TARGET CoAkkaV2::runtime_v2)
  message(FATAL_ERROR "Candidate config/target is outside the explicit prefix")
endif()
set(_startup_image "")
foreach(_startup_property IMPORTED_LOCATION_RELEASE IMPORTED_LOCATION_NOCONFIG IMPORTED_LOCATION)
  get_target_property(_startup_location CoAkkaV2::runtime_v2 ${_startup_property})
  if(_startup_location AND EXISTS "${_startup_location}")
    file(REAL_PATH "${_startup_location}" _startup_image)
    break()
  endif()
endforeach()
if(NOT _startup_image)
  message(FATAL_ERROR "Candidate target has no existing Release runtime image")
endif()
cmake_path(IS_PREFIX _startup_prefix "${_startup_image}" NORMALIZE _startup_inside)
if(NOT _startup_inside)
  message(FATAL_ERROR "Candidate runtime image is outside the explicit prefix")
endif()
if(COAKKA_NATIVE_EVIDENCE_REQUIRE_NATIVE_STARTUP)
  get_target_property(_startup_includes CoAkkaV2::runtime_v2 INTERFACE_INCLUDE_DIRECTORIES)
  unset(_startup_header_dir CACHE)
  find_path(_startup_header_dir NAMES coakka/v2/runtime_startup.h
    PATHS ${_startup_includes} NO_DEFAULT_PATH)
  if(NOT _startup_header_dir)
    message(FATAL_ERROR "The selected runtime artifact does not expose runtime_startup.h")
  endif()
  file(REAL_PATH "${_startup_header_dir}/coakka/v2/runtime_startup.h" _startup_header)
  cmake_path(IS_PREFIX _startup_prefix "${_startup_header}" NORMALIZE _startup_inside)
  if(NOT _startup_inside)
    message(FATAL_ERROR "Candidate startup header is outside the explicit prefix")
  endif()
endif()
file(SHA256 "${_startup_image}" _startup_image_sha)
file(WRITE "${CMAKE_CURRENT_BINARY_DIR}/native-startup-imported-runtime.txt"
  "config=${_startup_config}\nimage=${_startup_image}\nsha256=${_startup_image_sha}\n")
