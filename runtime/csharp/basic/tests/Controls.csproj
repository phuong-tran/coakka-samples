<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType><TargetFramework>net8.0</TargetFramework><LangVersion>12.0</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings><Nullable>enable</Nullable><EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors><EnableNETAnalyzers>true</EnableNETAnalyzers><AnalysisLevel>8.0</AnalysisLevel>
    <StartupObject>CoAkka.Samples.Runtime.CSharp.Basic.SampleControls</StartupObject>
  </PropertyGroup>
  <ItemGroup><Compile Include="../Program.cs" Link="Application/Program.cs"/><Compile Include="SampleControls.cs"/>
    <PackageReference Include="CoAkka.Runtime" Version="$(CoAkkaCandidateVersion)"/></ItemGroup>
</Project>
