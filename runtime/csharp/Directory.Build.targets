<Project>
  <!-- Cold build admission only. Runtime configuration and native loading stay in the package. -->
  <UsingTask TaskName="AdmitRuntimeCandidate" TaskFactory="RoslynCodeTaskFactory"
             AssemblyFile="$(MSBuildToolsPath)/Microsoft.Build.Tasks.Core.dll">
    <ParameterGroup>
      <Version ParameterType="System.String" Required="true"/>
      <FileName ParameterType="System.String" Required="true"/>
      <Bytes ParameterType="System.Int64" Required="true"/>
      <Digest ParameterType="System.String" Required="true"/>
    </ParameterGroup>
    <Task>
      <Using Namespace="System"/><Using Namespace="System.IO"/><Using Namespace="System.Security.Cryptography"/>
      <Code Type="Fragment" Language="cs"><![CDATA[
        try {
          Func<string, string> directory = key => {
            var value = Environment.GetEnvironmentVariable(key);
            if (String.IsNullOrWhiteSpace(value) || !Path.IsPathRooted(value)
                || Path.GetPathRoot(value) != Path.GetPathRoot(Path.GetFullPath(value)) || !Directory.Exists(value))
              throw new InvalidOperationException("Existing absolute " + key + " is required.");
            var full = Path.GetFullPath(value);
            for (var part = new DirectoryInfo(full); part != null; part = part.Parent)
              if ((part.Attributes & FileAttributes.ReparsePoint) != 0)
                throw new InvalidOperationException("Build input/cache roots must not contain links.");
            return full;
          };
          var home = directory("COAKKA_CSHARP_CANDIDATE_HOME");
          var work = directory("COAKKA_SAMPLE_WORK_ROOT");
          var cache = directory("NUGET_PACKAGES");
          directory("DOTNET_CLI_HOME");
          if (home == work || home == cache || work == cache)
            throw new InvalidOperationException("Candidate, work and NuGet roots must be distinct.");
          if (Bytes < 1 || Bytes > 8388608 || Path.GetFileName(FileName) != FileName || Digest.Length != 64)
            throw new InvalidOperationException("Invalid trusted candidate catalog.");
          Action<string> admit = path => {
            var info = new FileInfo(path);
            if (!info.Exists || (info.Attributes & (FileAttributes.ReparsePoint | FileAttributes.Directory)) != 0 || info.Length != Bytes)
              throw new InvalidOperationException("Candidate size/type admission failed.");
            using (var input = new FileStream(path, FileMode.Open, FileAccess.Read, FileShare.Read, 65536))
            using (var hash = SHA256.Create())
              if (!String.Equals(BitConverter.ToString(hash.ComputeHash(input)).Replace("-", ""), Digest, StringComparison.OrdinalIgnoreCase))
                throw new InvalidOperationException("Candidate integrity admission failed.");
          };
          var feed = new DirectoryInfo(Path.Combine(home, "feed"));
          if (!feed.Exists || (feed.Attributes & FileAttributes.ReparsePoint) != 0)
            throw new InvalidOperationException("A regular candidate feed is required.");
          var entries = feed.EnumerateFileSystemInfos().GetEnumerator();
          using (entries) {
            if (!entries.MoveNext() || entries.Current.Name != FileName || entries.MoveNext())
              throw new InvalidOperationException("Candidate feed must contain exactly the catalog package.");
          }
          admit(Path.Combine(feed.FullName, FileName));
          var cached = Path.Combine(cache, "coakka.runtime", Version);
          if (Directory.Exists(cached)) {
            if ((new DirectoryInfo(cached).Attributes & FileAttributes.ReparsePoint) != 0)
              throw new InvalidOperationException("Candidate cache must not be a link.");
            admit(Path.Combine(cached, "coakka.runtime." + Version + ".nupkg"));
          }
          Log.LogMessage(Microsoft.Build.Framework.MessageImportance.High, "Exact private runtime candidate admitted.");
        } catch (Exception error) {
          Log.LogError(error.Message);
          return false;
        }
      ]]></Code>
    </Task>
  </UsingTask>
  <Target Name="AdmitCoAkkaCandidate" BeforeTargets="Restore;PrepareForBuild">
    <Error Condition="'$(COAKKA_RUNTIME_LIB)' != ''" Text="Candidate sample refuses a native-library override."/>
    <Error Condition="'$(CoAkkaCandidateState)' != 'private-candidate'" Text="Private candidate catalog required."/>
    <AdmitRuntimeCandidate Version="$(CoAkkaCandidateVersion)" FileName="$(CoAkkaCandidateFile)"
                           Bytes="$(CoAkkaCandidateBytes)" Digest="$(CoAkkaCandidateSha256)"/>
  </Target>
  <PropertyGroup>
    <CoAkkaCandidateScriptsRoot>$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)../../scripts'))</CoAkkaCandidateScriptsRoot>
    <CoAkkaArtifactPythonExe Condition="'$(CoAkkaArtifactPythonExe)' == '' and '$(COAKKA_ARTIFACT_PYTHON)' != ''">$(COAKKA_ARTIFACT_PYTHON)</CoAkkaArtifactPythonExe>
    <CoAkkaArtifactPythonExe Condition="'$(CoAkkaArtifactPythonExe)' == ''">python</CoAkkaArtifactPythonExe>
  </PropertyGroup>
  <!-- Artifact policy is the generated Core utility, not connector/runtime code.
       Its private original is outside PublishDir; only verified metadata is promoted. -->
  <Target Name="FinalizeCoAkkaGeneratedApphost" AfterTargets="Publish"
          Condition="'$(CoAkkaFinalizeGeneratedApphost)' == 'true' and '$(RuntimeIdentifier)' == 'win-x64'">
    <PropertyGroup>
      <CoAkkaPublishedApphost>$([System.IO.Path]::GetFullPath('$(PublishDir)$(AssemblyName).exe'))</CoAkkaPublishedApphost>
    </PropertyGroup>
    <Exec Timeout="15000" Command="&quot;$(CoAkkaArtifactPythonExe)&quot; -I -B &quot;$(CoAkkaCandidateScriptsRoot)/finalize-csharp-apphost.py&quot; --input &quot;$(CoAkkaPublishedApphost)&quot; --work-root &quot;$(COAKKA_SAMPLE_WORK_ROOT)&quot; --bytes &quot;$(CoAkkaCandidateWindowsApphostBytes)&quot; --raw-sha256 &quot;$(CoAkkaCandidateWindowsApphostRawSha256)&quot; --final-sha256 &quot;$(CoAkkaCandidateWindowsApphostFinalSha256)&quot; --tool-sha256 &quot;$(CoAkkaCandidateArtifactToolSha256)&quot;"/>
  </Target>
</Project>
